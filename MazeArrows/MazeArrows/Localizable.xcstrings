    "Pick a photo with a clear silhouette — we turn it into a maze of arrows." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle ein Foto mit klarer Silhouette – wir verwandeln es in ein Labyrinth aus Pfeilen."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a photo with a clear silhouette — we turn it into a maze of arrows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una foto con una silueta clara y la convertiremos en un laberinto de flechas."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una foto con una silueta clara y la convertiremos en un laberinto de flechas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une photo à la silhouette nette : nous la transformons en labyrinthe de flèches."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साफ़ आकृति वाली फ़ोटो चुनें — हम उसे तीरों की भूलभुलैया में बदल देंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih foto dengan siluet yang jelas — kami mengubahnya menjadi labirin panah."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シルエットがはっきりした写真を選んでください。矢印の迷路に変換します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실루엣이 뚜렷한 사진을 고르면 화살표 미로로 만들어 드려요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma foto com uma silhueta nítida — nós a transformamos em um labirinto de setas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
