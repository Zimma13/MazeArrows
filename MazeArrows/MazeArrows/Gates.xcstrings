    "Two gates on one path need both keys.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two gates on one path need both keys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei zwei Toren auf einem Weg brauchst du beide Schlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos puertas en un mismo camino necesitan ambas llaves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux portes sur un même passage nécessitent les deux clés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक रास्ते पर दो द्वार हों तो दोनों चाबियाँ चाहिए।"
          }
        },
        "id": {
