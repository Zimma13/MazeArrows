          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ進路にゲートが2つあるときは、両方の鍵が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 경로에 관문이 두 개 있으면 두 열쇠가 모두 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois portões no mesmo caminho precisam das duas chaves."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois portões no mesmo caminho precisam das duas chaves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для двух ворот на одном пути нужны оба ключа."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้ามีประตูสองบานในเส้นทางเดียวกัน ต้องใช้กุญแจทั้งสองดอก"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一路徑上有兩扇門時，需要兩把鑰匙。"
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Two gates on one path need both keys."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos puertas en un mismo camino necesitan ambas llaves."
          }
        }
      }
    },
    "Your turn. Inspect gates for free; blocked moves cost a heart.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your turn. Inspect gates for free; blocked moves cost a heart."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist dran. Tore anzusehen ist kostenlos; blockierte Züge kosten ein Herz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu turno. Consultar las puertas es gratis; los movimientos bloqueados cuestan un corazón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À vous de jouer. Examiner les portes est gratuit ; un déplacement bloqué coûte un cœur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब आपकी बारी। द्वारों को देखना मुफ़्त है; रुकी हुई चाल पर एक दिल खर्च होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Giliranmu. Memeriksa gerbang gratis; langkah yang terhalang menghabiskan satu hati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今度は自分で挑戦しましょう。ゲートの確認は無料ですが、動けない矢印を動かそうとするとハートを1つ失います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 직접 해 보세요. 관문 살펴보기는 무료이며, 막힌 화살표를 움직이려 하면 하트가 하나 줄어듭니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua vez. Consultar portões é grátis; movimentos bloqueados custam um coração."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É a sua vez. Consultar portões é grátis; as jogadas bloqueadas custam um coração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь самостоятельно. Осмотр ворот бесплатный; за заблокированный ход теряется сердце."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตาคุณแล้ว ตรวจดูประตูได้ฟรี แต่การขยับลูกศรที่ถูกขวางจะเสียหัวใจหนึ่งดวง"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輪到你了。查看門不需任何消耗，但嘗試移動受阻的箭頭會損失一顆愛心。"
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Your turn. Inspect gates for free; blocked moves cost a heart."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu turno. Consultar las puertas es gratis; los movimientos bloqueados cuestan un corazón."
          }
        }
      }
    },
