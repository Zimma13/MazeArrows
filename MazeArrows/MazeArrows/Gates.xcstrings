          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O portão está aberto. Agora remova as setas por sua conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ворота открыты. Теперь уберите стрелки самостоятельно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประตูเปิดแล้ว ลองนำลูกศรออกด้วยตัวเอง"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "門已開啟。接著試著自行移除箭頭。"
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
