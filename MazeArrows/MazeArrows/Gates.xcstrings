    "Double-tap to inspect its key and connected gates. No move is made.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap to inspect its key and connected gates. No move is made."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppeltippen, um den Schlüssel und die verbundenen Tore anzusehen. Es wird kein Zug ausgeführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para consultar su llave y las puertas vinculadas. No se realiza ningún movimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux fois pour examiner sa clé et les portes associées. Aucun déplacement n’est effectué."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसकी चाबी और जुड़े द्वार देखने के लिए दो बार टैप करें। कोई चाल नहीं चलेगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk dua kali untuk memeriksa kunci dan gerbang yang terhubung. Tidak ada langkah yang dijalankan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブルタップすると、対応する鍵とつながっているゲートを確認できます。矢印は動きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번 탭하여 해당 열쇠와 연결된 관문을 살펴봅니다. 화살표는 움직이지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes para consultar a chave e os portões vinculados. Nenhum movimento será feito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes para consultar a chave e os portões associados. Não é efetuada nenhuma jogada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь дважды, чтобы осмотреть ключ и связанные ворота. Это не ход."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะสองครั้งเพื่อตรวจดูกุญแจและประตูที่เชื่อมโยง โดยไม่เดินหมาก"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點兩下可查看對應的鑰匙與相連的門，不會移動箭頭。"
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap to inspect its key and connected gates. No move is made."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para consultar su llave y las puertas vinculadas. No se realiza ningún movimiento."
          }
        }
      }
    },
    "Double-tap to move. Use Actions to inspect connected gates or describe the path.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap to move. Use Actions to inspect connected gates or describe the path."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppeltippen zum Bewegen. Über „Aktionen“ kannst du verbundene Tore ansehen oder den Weg beschreiben lassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para mover. Usa Acciones para consultar las puertas vinculadas o escuchar una descripción del camino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux fois pour déplacer la flèche. Utilisez Actions pour examiner les portes associées ou décrire le passage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चलाने के लिए दो बार टैप करें। जुड़े द्वार देखने या रास्ते का विवरण सुनने के लिए कार्रवाइयाँ इस्तेमाल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk dua kali untuk bergerak. Gunakan Tindakan untuk memeriksa gerbang terhubung atau mendengar penjelasan jalur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブルタップで移動します。「アクション」でつながっているゲートの確認や進路の説明ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번 탭하여 움직입니다. 동작 메뉴에서 연결된 관문을 살펴보거나 경로 설명을 들을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes para mover. Use Ações para consultar os portões vinculados ou ouvir a descrição do caminho."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes para mover. Use Ações para consultar os portões associados ou ouvir a descrição do caminho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь дважды, чтобы сделать ход. В меню «Действия» можно осмотреть связанные ворота или узнать о пути."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะสองครั้งเพื่อขยับ ใช้เมนูการกระทำเพื่อตรวจดูประตูที่เชื่อมโยงหรือฟังคำอธิบายเส้นทาง"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點兩下即可移動。使用「動作」可查看相連的門或聆聽路徑說明。"
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap to move. Use Actions to inspect connected gates or describe the path."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para mover. Usa Acciones para consultar las puertas vinculadas o escuchar una descripción del camino."
          }
        }
      }
    },
