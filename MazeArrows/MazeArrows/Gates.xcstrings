    "The gate is open. Clear the arrows yourself.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gate is open. Clear the arrows yourself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Tor ist offen. Entferne nun selbst die Pfeile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La puerta está abierta. Ahora retira las flechas por tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La porte est ouverte. Retirez maintenant les flèches vous-même."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "द्वार खुल गया है। अब तीरों को खुद हटाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerbang terbuka. Sekarang singkirkan sendiri panahnya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲートが開きました。あとは自分で矢印を取り除きましょう。"
          }
        },
        "ko": {
          "stringUnit": {
