{
  "sourceLanguage": "en",
  "strings": {
    "Clear the blocking arrow first.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear the blocking arrow first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entferne zuerst den blockierenden Pfeil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retira primero la flecha que bloquea el camino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirez d’abord la flèche qui bloque le passage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले रास्ता रोकने वाला तीर हटाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Singkirkan dahulu panah yang menghalangi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず進路をふさいでいる矢印を取り除きましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 길을 막는 화살표를 제거하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova primeiro a seta que bloqueia o caminho."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova primeiro a seta que bloqueia o caminho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала уберите стрелку, которая мешает."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำลูกศรที่ขวางทางออกก่อน"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先移除擋路的箭頭。"
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear the blocking arrow first."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Retira primero la flecha que bloquea el camino."
          }
        }
      }
    },
    "Clear the key arrow to open every gate with the same symbol.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear the key arrow to open every gate with the same symbol."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entferne den Schlüsselpfeil, um alle Tore mit demselben Symbol zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retira la flecha con llave para abrir todas las puertas con el mismo símbolo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirez la flèche-clé pour ouvrir toutes les portes avec le même symbole."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ही चिह्न वाले सभी द्वार खोलने के लिए चाबी वाला तीर हटाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Singkirkan panah kunci untuk membuka semua gerbang dengan simbol yang sama."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵の矢印を取り除くと、同じマークのゲートがすべて開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열쇠 화살표를 제거하면 같은 기호의 관문이 모두 열립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova a seta com chave para abrir todos os portões com o mesmo símbolo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova a seta com chave para abrir todos os portões com o mesmo símbolo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уберите стрелку с ключом, чтобы открыть все ворота с таким же знаком."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำลูกศรกุญแจออกเพื่อเปิดประตูทุกบานที่มีสัญลักษณ์เดียวกัน"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除鑰匙箭頭，即可開啟所有帶有相同符號的門。"
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear the key arrow to open every gate with the same symbol."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Retira la flecha con llave para abrir todas las puertas con el mismo símbolo."
          }
        }
      }
    },
    "Closed. Needs the %@ key. Connected gates: %lld.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closed. Needs the %@ key. Connected gates: %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschlossen. Benötigt den Schlüssel mit dem Symbol %1$@. Verbundene Tore: %2$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrada. Necesita la llave con el símbolo %1$@. Puertas vinculadas: %2$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermée. Nécessite la clé avec le symbole %1$@. Portes associées : %2$lld."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद है। %1$@ चिह्न वाली चाबी चाहिए। जुड़े द्वार: %2$lld।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tertutup. Perlu kunci bersimbol %1$@. Gerbang terhubung: %2$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じています。%1$@のマークの鍵が必要です。つながっているゲート：%2$lld個。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫혀 있습니다. %1$@ 기호 열쇠가 필요합니다. 연결된 관문: %2$lld개."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechado. Precisa da chave com o símbolo %1$@. Portões vinculados: %2$lld."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechado. Precisa da chave com o símbolo %1$@. Portões associados: %2$lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыто. Нужен ключ со знаком «%1$@». Связанных ворот: %2$lld."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดอยู่ ต้องใช้กุญแจสัญลักษณ์%1$@ ประตูที่เชื่อมโยง: %2$lld บาน"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已關閉。需要%1$@符號的鑰匙。相連的門：%2$lld 扇。"
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Closed. Needs the %@ key. Connected gates: %lld."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrada. Necesita la llave con el símbolo %1$@. Puertas vinculadas: %2$lld."
          }
        }
      }
    },
